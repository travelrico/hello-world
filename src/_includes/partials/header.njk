{% from "macros.njk" import t, tt %}
<header class="site-header" id="top">
  {# Ordinateur et tablette #}
  <div class="nav-desk">
    <a class="brand" href="{{ '/' | url }}" aria-label="Eric Van Hees — accueil">
      <img src="{{ '/assets/images/logo_picto_name_01.svg' | url }}" alt="Eric Van Hees" height="40">
    </a>
    <nav class="nav-links" aria-label="Navigation principale">
      <a href="{{ '/projets/' | url }}"{% if active == 'projects' %} aria-current="page"{% endif %}>01 {{ t(site.nav.projects) }}</a>
      <a href="{{ '/a-propos/' | url }}"{% if active == 'about' %} aria-current="page"{% endif %}>02 {{ t(site.nav.about) }}</a>
      <a href="{{ '/contact/' | url }}"{% if active == 'contact' %} aria-current="page"{% endif %}>03 {{ t(site.nav.contact) }}</a>
    </nav>
    <div class="nav-right">
      {% if backToIndex %}<a href="{{ '/projets/' | url }}">← Index</a>{% else %}<span>{{ t(site.location) }}</span>{% endif %}
      <div class="lang" role="group" aria-label="Langue / Language">
        <button type="button" data-set-locale="fr">FR</button>
        <span aria-hidden="true">/</span>
        <button type="button" data-set-locale="en">EN</button>
      </div>
    </div>
  </div>

  {# Mobile #}
  <div class="nav-mob">
    <a class="brand" href="{{ '/' | url }}" aria-label="Eric Van Hees — accueil">
      <img src="{{ '/assets/images/logo_picto_01.svg' | url }}" alt="Eric Van Hees" height="32">
    </a>
    <button type="button" class="box-btn" data-menu-open aria-expanded="false" aria-controls="menu">
      <span>Menu</span><span aria-hidden="true">+</span>
    </button>
  </div>
  <div class="rule" data-rule></div>

  {# Menu plein écran (mobile) #}
  <div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
    <div class="menu-top">
      <span class="label">Eric Van Hees</span>
      <button type="button" class="box-btn box-btn--light" data-menu-close>
        <span>{{ tt("Fermer", "Close") }}</span><span aria-hidden="true">×</span>
      </button>
    </div>
    <div class="rule rule--light"></div>
    <nav class="menu-links" aria-label="Navigation principale">
      <a href="{{ '/projets/' | url }}"><span class="menu-num">01</span>{{ t(site.nav.projects) }}</a>
      <a href="{{ '/a-propos/' | url }}"><span class="menu-num">02</span>{{ t(site.nav.about) }}</a>
      <a href="{{ '/contact/' | url }}"><span class="menu-num">03</span>{{ t(site.nav.contact) }}</a>
    </nav>
    <div class="menu-bottom">
      <span>{{ t(site.location) }}</span>
      <div class="lang lang--menu" role="group" aria-label="Langue / Language">
        <button type="button" data-set-locale="fr">FR</button>
        <button type="button" data-set-locale="en">EN</button>
      </div>
    </div>
  </div>
</header>
