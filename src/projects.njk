---
pagination:
  data: projects
  size: 1
  alias: project
permalink: "/projects/{{ project.slug }}/index.html"
layout: layouts/base.njk
active: projects
backToIndex: true
eleventyComputed:
  title: "{{ project.name | loc('fr') }} — {{ project.client }} — Eric Van Hees"
---
{% from "macros.njk" import t, tt %}
{% set hero = project.gallery[0] if (project.gallery and project.gallery.length) else { src: project.cover, alt: project.coverAlt } %}
{% set next = projects | nextProject(project.slug) %}

<header class="grid12 pad case-head">
  <div class="case-num reveal-line"><span data-reveal>{{ project.number }}</span></div>
  <div class="case-title">
    <h1 class="display display--xl reveal-line"><span data-reveal>{{ t(project.name) }}</span></h1>
    {% if project.intro %}<p class="lede case-intro">{{ t(project.intro) }}</p>{% endif %}
  </div>
</header>

<div class="rule" data-rule></div>
<dl class="meta">
  <div><dt class="label">Client</dt><dd>{{ project.client }}</dd></div>
  <div><dt class="label">Discipline</dt><dd>{{ t(project.category) }}</dd></div>
  <div><dt class="label">{{ tt("Distinction", "Award") }}</dt><dd>{% if project.award %}{{ t(project.award) }}{% else %}—{% endif %}</dd></div>
  <div><dt class="label">{{ tt("Rôle", "Role") }}</dt><dd>{% if project.role %}{{ t(project.role) }}{% else %}{{ tt("Direction artistique", "Art direction") }}{% endif %}</dd></div>
</dl>
<div class="rule"></div>

<figure class="media case-hero">
  <img src="{{ hero.src | url }}" alt="{{ hero.alt.fr }}" data-alt-fr="{{ hero.alt.fr }}" data-alt-en="{{ hero.alt.en }}"{% if project.coverPosition %} style="object-position: {{ project.coverPosition }}"{% endif %}>
</figure>

<section class="grid12 pad case-story">
  <div class="case-story-label">
    <div class="rule" data-rule></div>
    <h2 class="label label--strong">{{ tt("L'enjeu", "The challenge") }}</h2>
  </div>
  <div class="case-story-text">
    <div class="rule" data-rule></div>
    <div class="case-paras" data-locale="fr">{% for para in project.description.fr %}<p>{{ para }}</p>{% endfor %}</div>
    <div class="case-paras" data-locale="en">{% for para in project.description.en %}<p>{{ para }}</p>{% endfor %}</div>
  </div>
</section>

<div class="gallery pad">
  {% for row in project.gallery | galleryRows(hero.src) %}
  <div class="gallery-row gallery-row--{{ row.type }}">
    {% for item in row.items %}
    <figure class="media">
      <img src="{{ item.src | url }}" alt="{{ item.alt.fr }}" data-alt-fr="{{ item.alt.fr }}" data-alt-en="{{ item.alt.en }}" loading="lazy">
    </figure>
    {% endfor %}
  </div>
  {% endfor %}
</div>

<a class="next" href="{{ ('/projects/' + next.slug + '/') | url }}">
  <span class="label label--strong">{{ tt("Projet suivant", "Next project") }}</span>
  <span class="next-title">{{ next.number }} · {{ t(next.name) }}</span>
  <span class="next-arrow" aria-hidden="true">↗</span>
</a>
