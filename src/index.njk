---
layout: layouts/base.njk
permalink: /
active: ""
---
{% from "macros.njk" import t, tt %}
<section class="pad hero">
  <h1 class="display display--xl" data-reveal-group>
    <span data-locale="fr">
      <span class="reveal-line"><span data-reveal>Rendre la santé</span></span>
      <span class="reveal-line"><span data-reveal>animale lisible.</span></span>
      <span class="reveal-line"><span data-reveal>Et inoubliable.</span></span>
    </span>
    <span data-locale="en">
      <span class="reveal-line"><span data-reveal>Making animal</span></span>
      <span class="reveal-line"><span data-reveal>health clear.</span></span>
      <span class="reveal-line"><span data-reveal>And unforgettable.</span></span>
    </span>
  </h1>
  <div class="grid12 hero-sub">
    <p class="hero-role">{{ tt("Directeur artistique senior", "Senior art director") }}<br>{{ tt("Motion designer · 20 ans", "Motion designer · 20 years") }}</p>
    <p class="lede hero-lede">{{ tt("Campagnes publicitaires et films d'animation, promotionnels ou didactiques, pour les laboratoires et les institutions de la santé animale.", "Advertising campaigns and animated films, promotional or educational, for animal health laboratories and institutions.") }}</p>
  </div>
</section>

<div class="rule" data-rule></div>
<section class="cards" aria-label="Projets">
  {% for p in projects %}
  <a class="card" href="{{ ('/projects/' + p.slug + '/') | url }}">
    <div class="media media--4-3">
      <img src="{{ p.cover | url }}" alt="{{ p.coverAlt.fr }}" data-alt-fr="{{ p.coverAlt.fr }}" data-alt-en="{{ p.coverAlt.en }}" loading="lazy"{% if p.coverPosition %} style="object-position: {{ p.coverPosition }}"{% endif %}>
    </div>
    <div class="card-text">
      <span class="num">{{ p.number }}</span>
      <div>
        <div class="card-title">{{ t(p.name) }}</div>
        <div class="card-meta">{{ p.client }} — {{ t(p.category) }}</div>
      </div>
    </div>
  </a>
  {% endfor %}
</section>

<section class="poster pad">
  <h2 class="poster-title">{{ tt("Une idée claire. Une image qui reste.", "A clear idea. An image that stays.") }}</h2>
  <a class="poster-cta" href="{{ '/contact/' | url }}"><span>{{ tt("Lancer un projet", "Start a project") }}</span><span aria-hidden="true">↗</span></a>
</section>
