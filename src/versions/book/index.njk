---
permalink: /versions/book/
---
{% extends "src/versions/book/_parts/base.njk" %}
{% block title %}Book — Eric Van Hees{% endblock %}
{% block content %}

{# Hero : vidéo plein cadre 16:9 (vidéo temporaire, à remplacer par le showreel) #}
<section class="bk-hero" aria-labelledby="bk-hero-title">
  <h1 class="bk-sr" id="bk-hero-title">Eric Van Hees — Directeur artistique & motion designer / Art director & motion designer</h1>
  <div class="bk-hero-frame">
    <video class="bk-hero-video" autoplay muted loop playsinline preload="metadata" poster="{{ '/assets/images/hero-poster.jpg' | url }}" aria-label="Film d'ouverture / Opening film">
      <source src="{{ '/assets/video/hero.mp4' | url }}" type="video/mp4">
    </video>
    {# Bouton pause : obligatoire pour une vidéo qui démarre seule (accessibilité) #}
    <button class="bk-hero-toggle" type="button" aria-pressed="false" aria-label="Mettre la vidéo en pause / Pause video"><span aria-hidden="true"></span></button>
  </div>
</section>

{# À propos (texte du book, FR puis EN) #}
<section class="bk-page bk-about" id="a-propos">
  <div class="bk-col">
    <h2 class="bk-sub">À propos de moi</h2>
    <p class="bk-fr">Directeur Artistique Senior et Motion Designer, j'accompagne les projets de la première idée à leur réalisation. Concepts, campagnes, identités visuelles ou contenus animés : je cherche des solutions créatives, claires et efficaces. Mon approche repose sur une culture visuelle solide, une exigence constante, et la conviction que la forme ne vaut que si elle est juste.</p>
    <h2 class="bk-sub bk-en">About me</h2>
    <p class="bk-en">Senior Art Director and Motion Designer, I work on projects from the initial idea through to final delivery. Concepts, campaigns, visual identities or motion content: I focus on creating clear, effective and compelling creative solutions. My approach is built on a strong visual culture, consistently high standards, and the belief that good design is about more than aesthetics — it's about getting it right.</p>
  </div>
  <ol class="bk-toc">
    {% for p in projects %}<li><a href="#p-{{ p.slug }}"><span>.{{ loop.index }}</span>{{ p.client }} — {{ p.name | loc('fr') }}</a></li>{% endfor %}
  </ol>
</section>

{# Une page paysage par projet, mise en page du book : texte à gauche, mosaïque à droite #}
<div id="projets" class="bk-anchor"></div>
{% for p in projects %}
{% set imgs = p.gallery | withoutCover(p.cover) %}
<section class="bk-page bk-project" id="p-{{ p.slug }}">
  <div class="bk-col">
    <h2 class="bk-title">{{ p.client }}</h2>
    <h3 class="bk-sub">{{ p.name | loc('fr') }} / {{ p.category.fr }}</h3>
    <p class="bk-fr">{{ p.description.fr[0] }}</p>
    <span class="bk-dash" aria-hidden="true"></span>
    <h3 class="bk-sub bk-en">{{ p.name | loc('en') }} / {{ p.category.en }}</h3>
    <p class="bk-en">{{ p.description.en[0] }}</p>
    <a class="bk-link" href="{{ ('/versions/book/projects/' + p.slug + '/') | url }}">Voir le projet · View project →</a>
  </div>
  <a class="bk-mosaic" href="{{ ('/versions/book/projects/' + p.slug + '/') | url }}" tabindex="-1" aria-hidden="true">
    <span class="bk-mosaic-main"><img src="{{ p.cover | url }}" alt="" loading="lazy"{% if p.coverPosition %} style="object-position:{{ p.coverPosition }}"{% endif %}></span>
    {% for item in imgs %}{% if loop.index <= 3 %}<span class="bk-mosaic-thumb"><img src="{{ item.src | url }}" alt="" loading="lazy"></span>{% endif %}{% endfor %}
  </a>
</section>
{% endfor %}

{# Dernière page : contact #}
<section class="bk-page bk-contact" id="contact">
  <div class="bk-col">
    <h2 class="bk-title">Contact</h2>
    <p class="bk-fr">Eric Van Hees<br><a href="mailto:{{ site.email }}">{{ site.email }}</a><br>Paris / France</p>
  </div>
</section>
{% endblock %}
