{# Version 6 — Book : squelette (picto et mention verticale fixes, comme sur chaque page du book PDF).
   Comme dans le book, le français et l'anglais sont affichés ensemble : pas de sélecteur de langue. #}
{% extends "src/versions/_commun/base.njk" %}
{% block head %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/versions/book/style.css' | url }}">
{% endblock %}
{% block bodyClass %}bk{% if snap %} bk--snap{% endif %}{% endblock %}
{% block body %}
<a class="bk-picto" href="{{ '/versions/book/' | url }}" aria-label="Eric Van Hees — accueil / home"><img src="{{ '/assets/images/logo-picto.svg' | url }}" alt="" width="52" height="35"></a>
<p class="bk-side" aria-hidden="true"><span>Artistic director</span><span class="bk-side-bar"></span><span>Directeur artistique</span></p>

<main id="main">
{% block content %}{% endblock %}
</main>
{% endblock %}
