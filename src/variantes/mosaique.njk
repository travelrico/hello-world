---
layout: layouts/base.njk
title: "Variante C — Mosaïque — Eric Van Hees"
permalink: "/variantes/mosaique/index.html"
variant: C
robots: noindex
filters:
  - { id: "campagne", fr: "Campagnes", en: "Campaigns" }
  - { id: "identite", fr: "Identités", en: "Identities" }
  - { id: "evenement", fr: "Événements", en: "Events" }
  - { id: "edition", fr: "Édition", en: "Publishing" }
  - { id: "packaging", fr: "Packaging", en: "Packaging" }
# Rythme des tuiles : grande, haute, petite, petite, large, large, pleine largeur
sizes: ["big", "tall", "small", "small", "wide", "wide", "full"]
---
<main id="main-content">
  {% include "partials/variant-switch.njk" %}
  <section class="projects-section variant-section section-wrap" id="projects" aria-labelledby="projects-title">
    <div class="section-heading reveal"><div><p class="eyebrow">C / <span data-locale="fr">Mosaïque</span><span data-locale="en" hidden>Mosaic</span></p><h2 id="projects-title"><span data-locale="fr">Projets</span><span data-locale="en" hidden>Projects</span><sup>{{ "0" if projects.length < 10 }}{{ projects.length }}</sup></h2></div><p class="section-note"><span data-locale="fr">Des tuiles de tailles variées, à filtrer par discipline.</span><span data-locale="en" hidden>Tiles of varying sizes, filterable by discipline.</span></p></div>
    <div class="mosaic-filters reveal" role="group" aria-label="Filtrer par discipline / Filter by discipline">
      <button type="button" data-filter="all" aria-pressed="true"><span data-locale="fr">Tous</span><span data-locale="en" hidden>All</span><sup>{{ projects.length }}</sup></button>
      {% for filter in filters %}<button type="button" data-filter="{{ filter.id }}" aria-pressed="false"><span data-locale="fr">{{ filter.fr }}</span><span data-locale="en" hidden>{{ filter.en }}</span><sup>{{ projects | countTag(filter.id) }}</sup></button>{% endfor %}
    </div>
    <div class="mosaic">
      {% for project in projects %}
      <a class="mosaic-item size-{{ sizes[loop.index0 % sizes.length] }}" href="{{ ('/projects/' + project.slug + '/') | url }}" data-tags="{{ project.tags | join(' ') }}">
        <img src="{{ project.cover | url }}"{% if project.coverPosition %} style="object-position:{{ project.coverPosition }}"{% endif %} alt="{{ project.coverAlt.fr }}" data-alt-fr="{{ project.coverAlt.fr }}" data-alt-en="{{ project.coverAlt.en }}" loading="lazy">
        <span class="mosaic-info"><span class="mosaic-num">{{ project.number }}</span><strong><span data-locale="fr">{{ project.name | loc('fr') }}</span><span data-locale="en" hidden>{{ project.name | loc('en') }}</span></strong><span class="mosaic-meta">{{ project.client }} · <span data-locale="fr">{{ project.category.fr }}</span><span data-locale="en" hidden>{{ project.category.en }}</span></span></span>
      </a>
      {% endfor %}
    </div>
    <p class="mosaic-status" role="status" aria-live="polite"></p>
  </section>
</main>
