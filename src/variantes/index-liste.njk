---
layout: layouts/base.njk
title: "Variante B — Index — Eric Van Hees"
permalink: "/variantes/index/index.html"
variant: B
robots: noindex
---
<main id="main-content">
  {% include "partials/variant-switch.njk" %}
  <section class="projects-section variant-section section-wrap" id="projects" aria-labelledby="projects-title">
    <div class="section-heading reveal"><div><p class="eyebrow">B / Index</p><h2 id="projects-title"><span data-locale="fr">Projets</span><span data-locale="en" hidden>Projects</span><sup>{{ "0" if projects.length < 10 }}{{ projects.length }}</sup></h2></div><p class="section-note"><span data-locale="fr">Une liste typographique. Survolez un titre pour découvrir le visuel.</span><span data-locale="en" hidden>A typographic list. Hover a title to reveal the visual.</span></p></div>
    <div class="index-head" aria-hidden="true"><span>N°</span><span data-locale="fr">Projet</span><span data-locale="en" hidden>Project</span><span>Client</span><span>Discipline</span></div>
    <ol class="project-index">
      {% for project in projects %}
      <li><a class="index-row reveal" href="{{ ('/projects/' + project.slug + '/') | url }}" data-preview="{{ project.cover | url }}">
        <span class="index-num">{{ project.number }}</span>
        <span class="index-thumb"><img src="{{ project.cover | url }}" alt="" loading="lazy"></span>
        <span class="index-name"><span data-locale="fr">{{ project.name | loc('fr') }}</span><span data-locale="en" hidden>{{ project.name | loc('en') }}</span></span>
        <span class="index-client">{{ project.client }}</span>
        <span class="index-cat"><span data-locale="fr">{{ project.category.fr }}</span><span data-locale="en" hidden>{{ project.category.en }}</span></span>
        <span class="index-arrow" aria-hidden="true">↗</span>
      </a></li>
      {% endfor %}
    </ol>
    {# Aperçu qui suit la souris (ordinateur uniquement, piloté par site.js) #}
    <div class="index-preview" aria-hidden="true"><img src="" alt=""></div>
  </section>
</main>
